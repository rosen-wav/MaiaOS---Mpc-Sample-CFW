@@ -0,0 +1,35 @@
+"""Assemble and link the MaiaOS v064 callback at its final address."""
+from pathlib import Path
+import subprocess
+
+from elftools.elf.elffile import ELFFile
+
+
+def build_callback(zig, output, address):
+    source = Path(__file__).with_suffix(".S")
+    obj = output / "v064-callback.o"
+    elf = output / "v064-callback.elf"
+    layout = output / "v064-callback.ld"
+    definitions = """callback_target_72a4000 = 0x72a4000;
+callback_target_7400100 = 0x7400100;
+callback_target_7401754 = 0x7401754;
+callback_target_7401c88 = 0x7401c88;
+callback_target_7403e94 = 0x7403e94;
+callback_target_7403f04 = 0x7403f04;
+callback_target_7404658 = 0x7404658;
+callback_target_740634c = 0x740634c;
+callback_target_7406428 = 0x7406428;
+callback_target_7406644 = 0x7406644;
+"""
+    layout.write_text(
+        f"SECTIONS {{ . = {address:#x}; .text : {{ *(.text) }} }}\n" + definitions
+    )
+    subprocess.run([zig, "cc", "-target", "aarch64-linux-none", "-c", str(source),
+                    "-o", str(obj)], check=True)
+    subprocess.run([zig, "ld.lld", "-e", "maia_v064_callback", "-T", str(layout),
+                    str(obj), "-o", str(elf)], check=True)
+    with elf.open("rb") as stream:
+        section = ELFFile(stream).get_section_by_name(".text")
+        if section["sh_addr"] != address or section["sh_size"] != 220:
+            raise ValueError("Unexpected v064 callback layout")
+        return section.data() + bytes(16)
